<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.oracle.genai</groupId>
        <artifactId>oci-genai-auth-java-parent</artifactId>
        <version>1.1.0</version>
    </parent>

    <artifactId>oci-genai-auth-java-core</artifactId>
    <packaging>jar</packaging>

    <name>OCI GenAI Auth :: Core</name>
    <description>
        OCI request signing and authentication utilities for calling OCI-hosted
        AI compatibility endpoints. Provides OCI IAM auth providers, per-request
        signing interceptor, compartment header injection, and endpoint resolution.
    </description>
    <url>https://github.com/oracle-samples/oci-genai-auth-java</url>

    <licenses>
        <license>
            <name>Universal Permissive License v 1.0</name>
            <url>https://oss.oracle.com/licenses/upl/</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>oracle</id>
            <name>Oracle</name>
            <organization>Oracle</organization>
            <organizationUrl>https://www.oracle.com/</organizationUrl>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/oracle-samples/oci-genai-auth-java.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/oracle-samples/oci-genai-auth-java.git</developerConnection>
        <url>https://github.com/oracle-samples/oci-genai-auth-java</url>
        <tag>HEAD</tag>
    </scm>

    <dependencies>
        <!-- OCI Java SDK — auth providers and request signing -->
        <dependency>
            <groupId>com.oracle.oci.sdk</groupId>
            <artifactId>oci-java-sdk-common</artifactId>
        </dependency>

        <!-- OkHttp — shared HTTP transport for signing interceptor -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp</artifactId>
        </dependency>

        <!-- OkHttp logging interceptor — optional debug logging -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>logging-interceptor</artifactId>
        </dependency>

        <!-- Logging facade -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- OpenAI SDK core — optional; required only when using OciOpenAIHttpClient -->
        <dependency>
            <groupId>com.openai</groupId>
            <artifactId>openai-java-core</artifactId>
            <version>${openai-java.version}</version>
            <optional>true</optional>
        </dependency>

        <!-- Google Gen AI SDK — optional; required only for Google SDK examples -->
        <dependency>
            <groupId>com.google.genai</groupId>
            <artifactId>google-genai</artifactId>
            <version>${google-genai.version}</version>
            <optional>true</optional>
        </dependency>

        <!-- OpenAI SDK — integration tests only -->
        <dependency>
            <groupId>com.openai</groupId>
            <artifactId>openai-java</artifactId>
            <version>${openai-java.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <id>add-legal-files-to-release-jars</id>
                        <phase>package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <zip destfile="${project.build.directory}/${project.build.finalName}.jar" update="true">
                                    <zipfileset file="${project.basedir}/../LICENSE.txt" fullpath="LICENSE.txt"/>
                                    <zipfileset file="${project.basedir}/../THIRD_PARTY_LICENSES.txt" fullpath="THIRD_PARTY_LICENSES.txt"/>
                                    <zipfileset file="${project.basedir}/../THIRD_PARTY_LICENSES.txt" fullpath="THIRD-PARTY_LICENSE.txt"/>
                                </zip>
                                <zip destfile="${project.build.directory}/${project.build.finalName}-sources.jar" update="true">
                                    <zipfileset file="${project.basedir}/../LICENSE.txt" fullpath="LICENSE.txt"/>
                                    <zipfileset file="${project.basedir}/../THIRD_PARTY_LICENSES.txt" fullpath="THIRD_PARTY_LICENSES.txt"/>
                                    <zipfileset file="${project.basedir}/../THIRD_PARTY_LICENSES.txt" fullpath="THIRD-PARTY_LICENSE.txt"/>
                                </zip>
                                <zip destfile="${project.build.directory}/${project.build.finalName}-javadoc.jar" update="true">
                                    <zipfileset file="${project.basedir}/../LICENSE.txt" fullpath="LICENSE.txt"/>
                                    <zipfileset file="${project.basedir}/../THIRD_PARTY_LICENSES.txt" fullpath="THIRD_PARTY_LICENSES.txt"/>
                                    <zipfileset file="${project.basedir}/../THIRD_PARTY_LICENSES.txt" fullpath="THIRD-PARTY_LICENSE.txt"/>
                                </zip>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
